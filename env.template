MGR_HTTP_ADDR=:8080
MGR_CONFIG_ROOT=/var/lib/mergen/vm.d
MGR_DATA_ROOT=/var/lib/mergen
MGR_RUN_ROOT=/run/mergen
MGR_GLOBAL_HOOKS_DIR=/var/lib/mergen/hooks.d
MGR_UNIT_PREFIX=mergen
MGR_SYSTEMCTL_PATH=systemctl
MGR_COMMAND_TIMEOUT_SECONDS=10
MGR_SHUTDOWN_TIMEOUT_SECONDS=15
MGR_PORT_START=20000
MGR_PORT_END=40000
MGR_GUEST_CIDR=172.30.0.0/24
MGR_BASE_ASSETS_DIR=/var/lib/mergen/base/current
MGR_IMAGES_ROOT=/var/lib/mergen/images
MGR_LOG_LEVEL=info
MGR_LOG_FORMAT=console

# Config S3 / MinIO (base images)
MERGEN_CONFIG_FILE=
MGR_CONFIG_S3_ENDPOINT=http://127.0.0.1:9000
MGR_CONFIG_S3_REGION=us-east-1
MGR_CONFIG_S3_BUCKET=mergen-config
MGR_CONFIG_S3_PREFIX=artifacts
MGR_CONFIG_S3_USERNAME=
MGR_CONFIG_S3_PASSWORD=
MGR_CONFIG_S3_ACCESS_KEY_ID=minioadmin
MGR_CONFIG_S3_SECRET_ACCESS_KEY=minioadmin
MGR_CONFIG_S3_SESSION_TOKEN=
MGR_CONFIG_S3_USE_PATH_STYLE=true
MGR_BASE_PLATFORM=linux-amd64
MGR_BASE_FLAVOR=buildroot
MGR_PROGRESS_EVERY_MILLISECONDS=250

# Converter user S3
MERGEN_CONVERTER_CONFIG_FILE=
MERGEN_CONVERTER_OUTPUT_ROOT=/var/lib/mergen/images
MERGEN_CONVERTER_USER_S3_ENDPOINT=http://127.0.0.1:9000
MERGEN_CONVERTER_USER_S3_REGION=us-east-1
MERGEN_CONVERTER_USER_S3_BUCKET=mergen-user
MERGEN_CONVERTER_USER_S3_PREFIX=users
MERGEN_CONVERTER_USER_S3_ACCESS_KEY_ID=minioadmin
MERGEN_CONVERTER_USER_S3_SECRET_ACCESS_KEY=minioadmin
MERGEN_CONVERTER_USER_S3_SESSION_TOKEN=
MERGEN_CONVERTER_USER_S3_USE_PATH_STYLE=true
MERGEN_CONVERTER_USERNAME=
MERGEN_CONVERTER_PASSWORD=

[Unit]
Description=Mergen microVM %i
After=network-online.target
Wants=network-online.target
OnFailure=mergen-failure@%i.service

[Service]
Type=simple
EnvironmentFile=-/var/lib/mergen/vm.d/%i/env
# Pre-start lifecycle stage: preflight + pre-start extensions (network, disk, custom hooks).
ExecCondition=/usr/local/bin/mergen-lifecycle pre-start %i
# Start lifecycle stage: launch Firecracker process as unit main process.
ExecStart=/usr/local/bin/mergen-lifecycle start %i
# Post-start lifecycle stage: configure Firecracker API via SDK and trigger InstanceStart.
ExecStartPost=/usr/local/bin/mergen-lifecycle post-start %i
# Stop lifecycle stage: run pre-stop hooks and best-effort graceful stop.
ExecStop=/usr/local/bin/mergen-lifecycle stop %i
# Post-stop lifecycle stage: cleanup extensions (network cleanup by default).
ExecStopPost=/usr/local/bin/mergen-lifecycle post-stop %i
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
